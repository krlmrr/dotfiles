#!/bin/bash
set -e

DOTFILES_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$DOTFILES_DIR/shared/functions.sh"

echo "Configuring dotfiles from $DOTFILES_DIR"

# Git config — symlinked, so edits are live. user.name/user.email are
# machine-specific and `git config --global` writes to ~/.gitconfig, which is
# now this repo's file — so keep the identity in a separate generated file that
# gitconfig [include]s, exactly as the jj block below does with conf.d/.
link "$DOTFILES_DIR/shared/git/gitconfig" ~/.gitconfig
link "$DOTFILES_DIR/shared/git/gitignore_global" ~/.gitignore_global
mkdir -p ~/.config/git
# Read the identity from the generated include. `git config --global` cannot see
# it: --global reads ~/.gitconfig only and does NOT resolve [include] directives,
# so it returns empty once ~/.gitconfig is just a symlink to the tracked file.
# Fall back to --global for machines migrating from the pre-symlink layout, where
# the identity is still written directly in ~/.gitconfig.
GIT_NAME="$(git config --file ~/.config/git/identity --get user.name 2>/dev/null || true)"
GIT_EMAIL="$(git config --file ~/.config/git/identity --get user.email 2>/dev/null || true)"
[ -z "$GIT_NAME" ]  && GIT_NAME="$(git config --global --get user.name 2>/dev/null || true)"
[ -z "$GIT_EMAIL" ] && GIT_EMAIL="$(git config --global --get user.email 2>/dev/null || true)"
if [ -n "$GIT_NAME" ] && [ -n "$GIT_EMAIL" ]; then
    cat > ~/.config/git/identity <<EOF
# generated by ./configure — do not edit, and do not commit
[user]
	name = $GIT_NAME
	email = $GIT_EMAIL
[core]
	excludesfile = $HOME/.gitignore_global
EOF
else
    echo "Skipping git identity — no user.name/user.email found; set them with 'git config --file ~/.config/git/identity user.name \"…\"'"
fi

# Git hooks
link "$DOTFILES_DIR/shared/git/hooks/pre-commit" "$DOTFILES_DIR/.git/hooks/pre-commit"

# zshrc — symlinked, so edits are live; it sources zsh/aliases.sh itself
link "$DOTFILES_DIR/zsh/zshrc" ~/.zshrc

# Shared configs
link "$DOTFILES_DIR/shared/nvim" ~/.config/nvim
link "$DOTFILES_DIR/shared/lazygit" "$HOME/Library/Application Support/lazygit"
# Zed config — symlink files individually, not the whole shared/zed/ directory.
# Linking the directory makes ~/.config/zed → shared/zed, which means any later
# `link X ~/.config/zed/keymap.json` writes a symlink INTO the repo at
# shared/zed/keymap.json — that's how a Mac-path keymap symlink ended up
# committed to shared/zed/ in the past.
mkdir -p ~/.config/zed
link "$DOTFILES_DIR/shared/zed/settings.json" ~/.config/zed/settings.json
link "$DOTFILES_DIR/shared/zed/themes" ~/.config/zed/themes
link "$DOTFILES_DIR/mac/zed-keymap.json" ~/.config/zed/keymap.json

# Jujutsu — config.toml is symlinked (live), but jj refuses to commit without an
# identity and that is machine-specific, so generate it into conf.d/ from the git
# identity instead of committing it.
link "$DOTFILES_DIR/shared/jj/config.toml" ~/.config/jj/config.toml
if [ -n "$GIT_NAME" ] && [ -n "$GIT_EMAIL" ]; then
    mkdir -p ~/.config/jj/conf.d
    cat > ~/.config/jj/conf.d/00-identity.toml <<EOF
# generated by ./configure — do not edit
[user]
name = "$GIT_NAME"
email = "$GIT_EMAIL"
EOF
else
    echo "Skipping jj identity — no git user.name/user.email configured, jj will refuse to commit until ~/.config/jj/conf.d/00-identity.toml is set"
fi

# Claude Code skills
link "$DOTFILES_DIR/shared/claude/skills/general" ~/.claude/skills/general
link "$DOTFILES_DIR/shared/claude/skills/laravel" ~/.claude/skills/laravel
link "$DOTFILES_DIR/shared/claude/skills/feature" ~/.claude/skills/feature
link "$DOTFILES_DIR/shared/claude/skills/vue" ~/.claude/skills/vue

# Ghostty — symlinked in both locations macOS reads from, so edits are live
link "$DOTFILES_DIR/ghostty/config" ~/.config/ghostty/config
link "$DOTFILES_DIR/ghostty/themes" ~/.config/ghostty/themes
link "$DOTFILES_DIR/ghostty/config" "$HOME/Library/Application Support/com.mitchellh.ghostty/config"
link "$DOTFILES_DIR/ghostty/themes" "$HOME/Library/Application Support/com.mitchellh.ghostty/themes"

link "$DOTFILES_DIR/mac/hammerspoon" ~/.hammerspoon
open -a Hammerspoon
link "$DOTFILES_DIR/mac/vscode/settings.json" "$HOME/Library/Application Support/Code/User/settings.json"
link "$DOTFILES_DIR/mac/vscode/keybindings.json" "$HOME/Library/Application Support/Code/User/keybindings.json"

echo "Done!"
