#!/bin/bash
set -e

DOTFILES_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$DOTFILES_DIR/functions.sh"

echo "Configuring dotfiles from $DOTFILES_DIR"

# Git config — symlinked, so edits are live. user.name/user.email are
# machine-specific and `git config --global` writes to ~/.gitconfig, which is
# now this repo's file — so keep the identity in a separate generated file that
# gitconfig [include]s, exactly as the jj block below does with conf.d/.
#
# Read the identity BEFORE the `link` call below replaces ~/.gitconfig: read the
# generated include first (already-migrated machines), then fall back to
# --global — which can only still see a pre-symlink ~/.gitconfig on a 1.x
# machine migrating for the first time. `link()` does `rm -rf` on its target,
# so once ~/.gitconfig is a symlink to the tracked file (no [user] section),
# the --global fallback would read nothing — it must run first.
GIT_NAME="$(git config --file ~/.config/git/identity --get user.name 2>/dev/null || true)"
GIT_EMAIL="$(git config --file ~/.config/git/identity --get user.email 2>/dev/null || true)"
[ -z "$GIT_NAME" ]  && GIT_NAME="$(git config --global --get user.name 2>/dev/null || true)"
[ -z "$GIT_EMAIL" ] && GIT_EMAIL="$(git config --global --get user.email 2>/dev/null || true)"
link "$DOTFILES_DIR/git/gitconfig" ~/.gitconfig
link "$DOTFILES_DIR/git/gitignore_global" ~/.gitignore_global
mkdir -p ~/.config/git
if [ -n "$GIT_NAME" ] && [ -n "$GIT_EMAIL" ]; then
    cat > ~/.config/git/identity <<EOF
# generated by ./configure — do not edit, and do not commit
[user]
	name = $GIT_NAME
	email = $GIT_EMAIL
[core]
	excludesfile = $HOME/.gitignore_global
EOF
else
    echo "Skipping git identity — no user.name/user.email found; set them with 'git config --file ~/.config/git/identity user.name \"…\"'"
fi

# zshrc — a real file, NOT a symlink, that sources the tracked one.
# It was a symlink until Herd appended its HERD_PHP_*_INI_SCAN_DIR exports to
# ~/.zshrc and they landed in tracked source. Anything that writes to ~/.zshrc
# (Herd on a PHP version change, installer scripts, `omz` tooling) now writes
# into this untracked shim instead. zsh/zshrc itself stays the real config and
# edits to it are still live, since the shim sources it on every shell start.
#
# Never rewrite the shim once it exists — that would delete whatever those tools
# appended. Create it only when missing (or when it is still the old symlink),
# and otherwise just make sure the source line is present.
if [ ! -f ~/.zshrc ] || [ -L ~/.zshrc ]; then
    rm -f ~/.zshrc
    cat > ~/.zshrc <<EOF
# Generated by ~/Code/dotfiles/configure. Deliberately a real file, not a
# symlink: tools that append machine-specific config here must not write into
# tracked source. Add local overrides below the source line.
source "$DOTFILES_DIR/zsh/zshrc"
EOF
elif ! grep -q 'dotfiles/zsh/zshrc' ~/.zshrc; then
    printf '\nsource "%s/zsh/zshrc"\n' "$DOTFILES_DIR" >> ~/.zshrc
fi

# Shared configs
link "$DOTFILES_DIR/nvim" ~/.config/nvim
link "$DOTFILES_DIR/lazygit" "$HOME/Library/Application Support/lazygit"
# Zed config — symlink files individually, not the whole zed/ directory.
# Linking the directory makes ~/.config/zed → zed/, which means any later
# `link X ~/.config/zed/keymap.json` writes a symlink INTO the repo at
# zed/keymap.json — that's how a Mac-path keymap symlink ended up
# committed to zed/ in the past.
mkdir -p ~/.config/zed
link "$DOTFILES_DIR/zed/settings.json" ~/.config/zed/settings.json
link "$DOTFILES_DIR/zed/themes" ~/.config/zed/themes
link "$DOTFILES_DIR/zed-keymap.json" ~/.config/zed/keymap.json

# Jujutsu — config.toml is symlinked (live), but jj refuses to commit without an
# identity and that is machine-specific, so generate it into conf.d/ from the git
# identity instead of committing it.
link "$DOTFILES_DIR/jj/config.toml" ~/.config/jj/config.toml
if [ -n "$GIT_NAME" ] && [ -n "$GIT_EMAIL" ]; then
    mkdir -p ~/.config/jj/conf.d
    cat > ~/.config/jj/conf.d/00-identity.toml <<EOF
# generated by ./configure — do not edit
[user]
name = "$GIT_NAME"
email = "$GIT_EMAIL"
EOF
else
    echo "Skipping jj identity — no git user.name/user.email configured, jj will refuse to commit until ~/.config/jj/conf.d/00-identity.toml is set"
fi

# Claude Code skills
link "$DOTFILES_DIR/claude/skills/general" ~/.claude/skills/general
link "$DOTFILES_DIR/claude/skills/laravel" ~/.claude/skills/laravel
link "$DOTFILES_DIR/claude/skills/feature" ~/.claude/skills/feature
link "$DOTFILES_DIR/claude/skills/vue" ~/.claude/skills/vue

# Ghostty — symlinked in both locations macOS reads from, so edits are live
link "$DOTFILES_DIR/ghostty/config" ~/.config/ghostty/config
link "$DOTFILES_DIR/ghostty/themes" ~/.config/ghostty/themes
link "$DOTFILES_DIR/ghostty/config" "$HOME/Library/Application Support/com.mitchellh.ghostty/config"
link "$DOTFILES_DIR/ghostty/themes" "$HOME/Library/Application Support/com.mitchellh.ghostty/themes"

link "$DOTFILES_DIR/hammerspoon" ~/.hammerspoon
open -a Hammerspoon
link "$DOTFILES_DIR/vscode/settings.json" "$HOME/Library/Application Support/Code/User/settings.json"
link "$DOTFILES_DIR/vscode/keybindings.json" "$HOME/Library/Application Support/Code/User/keybindings.json"

echo "Done!"
