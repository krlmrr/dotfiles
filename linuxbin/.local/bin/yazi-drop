#!/usr/bin/env python3
import os
import shutil
import subprocess
import sys
from urllib.parse import unquote, urlparse


def resolve(line):
    line = line.strip()
    if not line:
        return None
    if line.startswith("file://"):
        return unquote(urlparse(line).path)
    return line


def unique(dest, name):
    target = os.path.join(dest, name)
    if not os.path.exists(target):
        return target
    stem, ext = os.path.splitext(name)
    n = 1
    while os.path.exists(os.path.join(dest, f"{stem} ({n}){ext}")):
        n += 1
    return os.path.join(dest, f"{stem} ({n}){ext}")


dest = sys.argv[1] if len(sys.argv) > 1 else os.getcwd()
proc = subprocess.run(
    ["ripdrag", "--target", "--and-exit", "--no-click",
     "--content-width", "420", "--content-height", "320"],
    capture_output=True,
    text=True,
)

copied = 0
for line in proc.stdout.splitlines():
    src = resolve(line)
    if not src or not os.path.exists(src):
        continue
    target = unique(dest, os.path.basename(src.rstrip("/")))
    try:
        if os.path.isdir(src):
            shutil.copytree(src, target)
        else:
            shutil.copy2(src, target)
        copied += 1
    except OSError as err:
        print(f"skipped {src}: {err}", file=sys.stderr)

print(f"{copied} item(s) copied into {dest}")
