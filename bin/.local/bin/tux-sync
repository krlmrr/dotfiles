#!/usr/bin/env python3
import json
import os
import re
import subprocess
import sys
from datetime import date
from pathlib import Path

TODO_FILE = Path(os.environ.get("TODO_FILE", Path.home() / "todo.txt"))
ISSUE_LINK = re.compile(r"(?<!\S)(?:gh:([\w.-]+/[\w.-]+)#|https://github\.com/([\w.-]+/[\w.-]+)/issues/)(\d+)(?!\S)")
PRIORITY = re.compile(r"^\([A-Z]\) ")
TODAY = date.today().isoformat()


def gh_api(path, jq):
    result = subprocess.run(
        ["gh", "api", path, "--paginate", "--jq", jq],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        return None
    return [json.loads(line) for line in result.stdout.splitlines() if line]


def assigned_open_issues():
    issues = gh_api(
        "/issues?filter=assigned&state=open&per_page=100",
        '.[] | select(.pull_request == null) | {id: "\\(.repository.full_name)#\\(.number)", title}',
    )
    if issues is None:
        return None
    return {issue["id"]: " ".join(issue["title"].split()) for issue in issues}


def where_issue_lives_now(issue):
    repo, number = issue.split("#")
    found = gh_api(
        f"repos/{repo}/issues/{number}",
        '{id: "\\(.repository_url | sub(".*/repos/"; ""))#\\(.number)", state}',
    )
    return found[0] if found else None


def issue_in(line):
    link = ISSUE_LINK.search(line)
    return f"{link[1] or link[2]}#{link[3]}" if link else None


def url(issue):
    repo, number = issue.split("#")
    return f"https://github.com/{repo}/issues/{number}"


def linked(line, issue):
    return ISSUE_LINK.sub(url(issue), line, count=1)


def is_done(line):
    return line.startswith("x ")


def completed(line):
    return f"x {TODAY} {PRIORITY.sub('', line)}"


def synced(lines, open_issues):
    tracked = set()
    result = []
    for line in lines:
        issue = issue_in(line)
        if issue and not is_done(line) and issue not in open_issues:
            now = where_issue_lives_now(issue)
            if now:
                issue = now["id"]
                if now["state"] == "closed":
                    line = completed(line)
        if issue:
            line = linked(line, issue)
            tracked.add(issue)
        result.append(line)
    for issue, title in open_issues.items():
        if issue not in tracked:
            result.append(f"{TODAY} {title} {url(issue)}")
    return result


def main():
    open_issues = assigned_open_issues()
    if open_issues is None:
        sys.exit("tux-sync: could not reach GitHub")
    lines = TODO_FILE.read_text().splitlines() if TODO_FILE.exists() else []
    updated = synced(lines, open_issues)
    if updated != lines:
        TODO_FILE.write_text("\n".join(updated) + "\n")


main()
