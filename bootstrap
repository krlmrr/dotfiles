#!/bin/bash
# Stow this machine's packages, then do the four things stow cannot.
# Idempotent: safe to re-run at any time.
set -euo pipefail

DOTFILES="$(cd "$(dirname "$0")" && pwd)"
cd "$DOTFILES"

# --- Which packages does this machine want? ---------------------------------
HOST="$(hostname -s)"
LIST="hosts/$HOST.packages"
if [ ! -f "$LIST" ]; then
    case "$(uname)" in
        Darwin) LIST="hosts/default-minimal.packages" ;;
        Linux)  LIST="hosts/default-linux.packages" ;;
        *)      LIST="hosts/default-minimal.packages" ;;
    esac
    echo "No hosts/$HOST.packages — falling back to $LIST"
    echo "Create hosts/$HOST.packages to pin this machine's package set."
fi
PACKAGES="$(grep -v -e '^#' -e '^$' "$LIST")"

create_target_dirs() {
    pkg="$1"
    target_root="$2"
    [ -d "$pkg" ] || return 0
    while IFS= read -r -d '' dir; do
        rel="${dir#"$pkg"/}"
        mkdir -p "$target_root/$rel"
    done < <(find "$pkg" -mindepth 1 -type d -print0)
}

# --- Machine-local files, generated once into the gitignored local/ ---------
# Read the identity from the repo path (local/.config/git/identity), not the
# deployed ~/.config/git/identity symlink — that target may not exist yet on
# a fresh machine, before this same script's `stow -R` below creates it, and
# reading through it would just chase a broken link. Fall back to --global,
# which on a not-yet-migrated machine can still see a real ~/.gitconfig; once
# ~/.gitconfig is a symlink to tracked source (which carries no [user]
# section), that fallback reads nothing.
GIT_NAME="$(git config --file "$DOTFILES/local/.config/git/identity" --get user.name 2>/dev/null || true)"
GIT_EMAIL="$(git config --file "$DOTFILES/local/.config/git/identity" --get user.email 2>/dev/null || true)"
[ -z "$GIT_NAME" ]  && GIT_NAME="$(git config --global --get user.name 2>/dev/null || true)"
[ -z "$GIT_EMAIL" ] && GIT_EMAIL="$(git config --global --get user.email 2>/dev/null || true)"

mkdir -p local/.config/git local/.config/jj/conf.d

if [ -n "$GIT_NAME" ] && [ -n "$GIT_EMAIL" ]; then
    cat > local/.config/git/identity <<EOF
# generated by ./bootstrap — machine-local, never committed
[user]
	name = $GIT_NAME
	email = $GIT_EMAIL
[core]
	excludesfile = $HOME/.gitignore_global
EOF
    cat > local/.config/jj/conf.d/00-identity.toml <<EOF
# generated by ./bootstrap — machine-local, never committed
[user]
name = "$GIT_NAME"
email = "$GIT_EMAIL"
EOF
else
    echo "No git user.name/user.email found — skipping identity generation."
    echo "Set them, then re-run: git config --global user.name '…'"
fi

# The ~/.zshrc shim. A real file that sources tracked config, living inside the
# gitignored local/ package so that tools appending to ~/.zshrc (Herd writes
# HERD_PHP_*_INI_SCAN_DIR on every PHP version change) follow the symlink into
# untracked space instead of into tracked source. Never rewrite it once it
# exists — that would delete whatever those tools appended.
if [ ! -f local/.zshrc ]; then
    cat > local/.zshrc <<'EOF'
# Generated by ~/dotfiles/bootstrap. Machine-local and untracked: tools that
# append to ~/.zshrc write here, not into tracked source. Local overrides go
# below the source line.
source "$HOME/.config/zsh/zshrc"
EOF
fi

# --- Directories that must exist before stowing -----------------------------
# Where a target directory is absent, stow links the DIRECTORY itself rather
# than descending into it — folding it into a single symlink back at the
# package. Every file an app later writes under that path then lands inside
# this git repo instead of in a real directory. hammerspoon (Spoons),
# herdr (sockets/logs/session state), claude (projects/, todos/, credentials
# on a fresh machine where ~/.claude doesn't pre-exist) and local (the git/jj
# identity files and .zshrc just generated above) all hit this. Pre-creating
# every directory a package contains — derived from the package itself, not a
# hand-maintained list, since a hardcoded list rots the moment a package
# gains a subdirectory — forces stow to always descend and link leaf files
# only. Must run after local/ is populated above and immediately before the
# stow call below, so the scan sees the finished package, not an empty one.
# shellcheck disable=SC2086
for pkg in $PACKAGES; do
    [ "$pkg" = "vscode" ] && continue
    create_target_dirs "$pkg" "$HOME"
done

# --- Stow ------------------------------------------------------------------
# -R restows: remove then re-add, which picks up files added since last run.
# shellcheck disable=SC2086
stow -R --dir="$DOTFILES" --target="$HOME" $PACKAGES
echo "Stowed: $(echo $PACKAGES | tr '\n' ' ')"

# --- macOS extras ----------------------------------------------------------
if [ "$(uname)" = "Darwin" ]; then
    if [ -d vscode ]; then
        create_target_dirs vscode "$HOME/Library/Application Support"
        stow -R --dir="$DOTFILES" \
             --target="$HOME/Library/Application Support" vscode
        echo "Stowed: vscode (Library target)"
    fi
    if [ -d /Applications/Hammerspoon.app ]; then
        open -a Hammerspoon
    fi
fi

# --- Register the Claude hook ----------------------------------------------
# ~/.claude/settings.json holds unrelated machine state: a large permissions
# allowlist, model, statusLine, enabledPlugins, theme, and a SessionStart hook
# installed by herdr that is not in this repo. It cannot be owned or symlinked,
# only merged into.
python3 - "$HOME/.claude/settings.json" <<'PYHOOK'
import json, os, sys

path = sys.argv[1]
command = "python3 '%s/.claude/hooks/comment-check.py'" % os.path.expanduser("~")

try:
    with open(path) as handle:
        settings = json.load(handle)
except (OSError, ValueError):
    settings = {}

hooks = settings.setdefault("hooks", {})
entries = hooks.setdefault("PostToolUse", [])

for entry in entries:
    for hook in entry.get("hooks", []):
        if "comment-check.py" in hook.get("command", ""):
            hook["command"] = command
            break
    else:
        continue
    break
else:
    entries.append({
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{"type": "command", "command": command, "timeout": 10}],
    })

os.makedirs(os.path.dirname(path), exist_ok=True)
with open(path, "w") as handle:
    json.dump(settings, handle, indent=2)
    handle.write("\n")
PYHOOK

echo "Done."
