export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="robbyrussell"
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#757575'
ZSH_AUTOSUGGEST_HISTORY_IGNORE="nvr *"

plugins=(
    git
    zsh-autosuggestions
    zsh-syntax-highlighting
)

source $ZSH/oh-my-zsh.sh

setopt HIST_IGNORE_SPACE

# Silence Homebrew's env/auto-update hint banners
export HOMEBREW_NO_ENV_HINTS=1

export PATH="$HOME/.local/bin:$PATH:$HOME/.composer/vendor/bin:$HOME/.config/composer/vendor/bin"

# Aliases and functions. Sourced rather than concatenated at build time — the
# whole file is symlinked to ~/.zshrc now, so edits are live.
source "$HOME/Code/dotfiles/zsh/aliases.sh"
