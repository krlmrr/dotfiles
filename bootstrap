#!/bin/bash
# Stow this machine's packages, then do the four things stow cannot.
# Idempotent: safe to re-run at any time.
set -euo pipefail

DOTFILES="$(cd "$(dirname "$0")" && pwd)"
cd "$DOTFILES"

# --- Which packages does this machine want? ---------------------------------
HOST="$(hostname -s)"
LIST="hosts/$HOST.packages"
if [ ! -f "$LIST" ]; then
    case "$(uname)" in
        Darwin) LIST="hosts/default-minimal.packages" ;;
        Linux)  LIST="hosts/default-linux.packages" ;;
        *)      LIST="hosts/default-minimal.packages" ;;
    esac
    echo "No hosts/$HOST.packages — falling back to $LIST"
    echo "Create hosts/$HOST.packages to pin this machine's package set."
fi
PACKAGES="$(grep -v -e '^#' -e '^$' "$LIST")"

create_target_dirs() {
    pkg="$1"
    target_root="$2"
    [ -d "$pkg" ] || return 0
    while IFS= read -r -d '' dir; do
        rel="${dir#"$pkg"/}"
        mkdir -p "$target_root/$rel"
    done < <(find "$pkg" -mindepth 1 -type d -print0)
}

# --- Machine-local files, written straight to their real paths --------------
# Not a stow package: these are generated per machine and must never be
# committed, so there is no tracked source for a package to hold. Writing them
# here also makes ~/.config/git and ~/.config/jj real directories before the
# stow call below, which is what stops stow folding them (see below).
GIT_NAME="$(git config --file "$HOME/.config/git/identity" --get user.name 2>/dev/null || true)"
GIT_EMAIL="$(git config --file "$HOME/.config/git/identity" --get user.email 2>/dev/null || true)"
[ -z "$GIT_NAME" ]  && GIT_NAME="$(git config --global --get user.name 2>/dev/null || true)"
[ -z "$GIT_EMAIL" ] && GIT_EMAIL="$(git config --global --get user.email 2>/dev/null || true)"

mkdir -p "$HOME/.config/git" "$HOME/.config/jj/conf.d"

if [ -n "$GIT_NAME" ] && [ -n "$GIT_EMAIL" ]; then
    cat > "$HOME/.config/git/identity" <<EOF
# generated by ./bootstrap — machine-local, never committed
[user]
	name = $GIT_NAME
	email = $GIT_EMAIL
[core]
	excludesfile = $HOME/.gitignore_global
EOF
    cat > "$HOME/.config/jj/conf.d/00-identity.toml" <<EOF
# generated by ./bootstrap — machine-local, never committed
[user]
name = "$GIT_NAME"
email = "$GIT_EMAIL"
EOF
else
    echo "No git user.name/user.email found — skipping identity generation."
    echo "Set them, then re-run: git config --global user.name '…'"
fi

# --- Omarchy custom themes --------------------------------------------------
# Copied, not stowed. `omarchy theme set` stages a theme with `cp -r`, which
# copies a symlink verbatim; a stow-relative target valid in
# ~/.config/omarchy/themes/<t>/ resolves one level wrong once copied into
# current/next-theme/, so colors.toml goes missing and the template generator
# silently emits nothing — no btop.theme, ghostty.conf or hyprland.lua. Making
# the links absolute instead makes stow disown them. So Omarchy owns this
# directory and the repo keeps the source at omarchy-themes/, like wallpapers/.
if [ "$(uname)" = "Linux" ] && [ -d omarchy-themes ]; then
    mkdir -p "$HOME/.config/omarchy/themes"
    cp -RL omarchy-themes/. "$HOME/.config/omarchy/themes/"
    echo "Copied Omarchy themes: $(ls omarchy-themes | tr '\n' ' ')"
fi

# --- Omarchy theme links ----------------------------------------------------
# btop and Neovim read their colours from a symlink into Omarchy's generated
# theme state, recreated by `omarchy theme set` on every switch. They are state,
# not config, so no package owns them; stow also refuses an absolute symlink as
# a package source. Linux only: the path does not exist on macOS.
if [ "$(uname)" = "Linux" ] && [ -d "$HOME/.local/state/omarchy" ]; then
    mkdir -p "$HOME/.config/btop/themes" "$HOME/.config/nvim/lua/plugins"
    ln -snf "$HOME/.local/state/omarchy/current/theme/btop.theme" \
            "$HOME/.config/btop/themes/current.theme"
    ln -snf "$HOME/.local/state/omarchy/current/theme/neovim.lua" \
            "$HOME/.config/nvim/lua/plugins/theme.lua"
fi

# --- Directories that must exist before stowing -----------------------------
# Where a target directory is absent, stow links the DIRECTORY itself rather
# than descending into it — folding it into a single symlink back at the
# package. Every file an app later writes under that path then lands inside
# this git repo instead of in a real directory. hammerspoon (Spoons),
# herdr (sockets/logs/session state) and claude (projects/, todos/, credentials
# on a fresh machine where ~/.claude doesn't pre-exist) all hit this.
# Pre-creating every directory a package contains — derived from the package
# itself, not a hand-maintained list, since a hardcoded list rots the moment a
# package gains a subdirectory — forces stow to always descend and link leaf
# files only. Must run immediately before the stow call below.
# shellcheck disable=SC2086
for pkg in $PACKAGES; do
    [ "$pkg" = "vscode" ] && continue
    create_target_dirs "$pkg" "$HOME"
done

# --- Stow ------------------------------------------------------------------
# -R restows: remove then re-add, which picks up files added since last run.
# shellcheck disable=SC2086
stow -R --dir="$DOTFILES" --target="$HOME" $PACKAGES
echo "Stowed: $(echo $PACKAGES | tr '\n' ' ')"

# --- macOS extras ----------------------------------------------------------
if [ "$(uname)" = "Darwin" ]; then
    if [ -d vscode ]; then
        create_target_dirs vscode "$HOME/Library/Application Support"
        stow -R --dir="$DOTFILES" \
             --target="$HOME/Library/Application Support" vscode
        echo "Stowed: vscode (Library target)"
    fi
    if [ -d /Applications/Hammerspoon.app ]; then
        open -a Hammerspoon
    fi
fi

# --- Register the Claude hook ----------------------------------------------
# ~/.claude/settings.json holds unrelated machine state: a large permissions
# allowlist, model, statusLine, enabledPlugins, theme, and a SessionStart hook
# installed by herdr that is not in this repo. It cannot be owned or symlinked,
# only merged into.
python3 - "$HOME/.claude/settings.json" <<'PYHOOK'
import json, os, sys

path = sys.argv[1]
command = "python3 '%s/.claude/hooks/comment-check.py'" % os.path.expanduser("~")

try:
    with open(path) as handle:
        settings = json.load(handle)
except (OSError, ValueError):
    settings = {}

hooks = settings.setdefault("hooks", {})
entries = hooks.setdefault("PostToolUse", [])

for entry in entries:
    for hook in entry.get("hooks", []):
        if "comment-check.py" in hook.get("command", ""):
            hook["command"] = command
            break
    else:
        continue
    break
else:
    entries.append({
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{"type": "command", "command": command, "timeout": 10}],
    })

os.makedirs(os.path.dirname(path), exist_ok=True)
with open(path, "w") as handle:
    json.dump(settings, handle, indent=2)
    handle.write("\n")
PYHOOK

echo "Done."
